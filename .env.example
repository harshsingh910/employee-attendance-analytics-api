# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB Configuration (Local or MongoDB Atlas)
# Atlas URI Template: mongodb+srv://harshsingh:<db_password>@cluster0.lt4ss4x.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://harshsingh:<db_password>@cluster0.lt4ss4x.mongodb.net/?appName=Cluster0
MONGO_DB=attendance_db
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis Configuration (Portfolio Extended Mode)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2.0

# Redis Rate Limiting (Portfolio Extended Mode)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Celery Background Processing (Portfolio Extended Mode)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
